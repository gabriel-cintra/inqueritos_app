# Configurações do Sistema Jurídico MP
# Copie este arquivo para .env e preencha com seus dados

# Segurança
SECRET_KEY=sua-chave-secreta-muito-longa-e-aleatoria-aqui

# Banco de Dados MySQL
DB_USER=root
DB_PASSWORD=sua_senha_mysql
DB_HOST=localhost
DB_NAME=sistema_juridico

# Modo de execução (development ou production)
FLASK_ENV=production
